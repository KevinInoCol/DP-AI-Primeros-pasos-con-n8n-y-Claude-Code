{
  "mcpServers": {
    "n8n-mcp": {
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://TU-INSTANCIA-N8N.easypanel.host",
        "N8N_API_KEY": "PEGA_AQUI_TU_API_KEY_DE_N8N"
      }
    }
  }
}
